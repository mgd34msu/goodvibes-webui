{
  "name": "goodvibes-webui",
  "private": true,
  "version": "1.13.7",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "Browser operator surface for the GoodVibes daemon.",
  "scripts": {
    "dev": "vite",
    "build": "bun run presentation:check && bun run config-schema:check && bun run config-ownership:check && bun run internal-identifiers:check && bun run typecheck && vite build",
    "ci": "bun run test && bun run typecheck && bun run build",
    "presentation:generate": "bun run scripts/generate-presentation-tokens.ts",
    "presentation:check": "bun run scripts/generate-presentation-tokens.ts --check",
    "config-schema:generate": "bun run scripts/generate-config-schema.ts",
    "config-schema:check": "bun run scripts/generate-config-schema.ts --check",
    "config-ownership:generate": "bun run scripts/generate-config-ownership.ts",
    "config-ownership:check": "bun run scripts/generate-config-ownership.ts --check",
    "internal-identifiers:check": "bun run scripts/internal-identifier-check.ts",
    "preview": "vite preview --host 127.0.0.1 --port 3423 --strictPort",
    "pretest": "bun run scripts/sweep-stale-temp.ts",
    "test": "bun test --isolate",
    "coverage": "bun run scripts/coverage.ts",
    "pretest:live": "bun run scripts/sweep-stale-temp.ts",
    "test:live": "bun run scripts/live-daemon-smoke-runner.ts",
    "test:e2e": "playwright test",
    "e2e": "playwright test",
    "e2e:phone": "playwright test --project=phone",
    "e2e:desktop": "playwright test --project=desktop",
    "typecheck": "bun run typecheck:src && bun run typecheck:scripts && bun run typecheck:e2e && bun run typecheck:coverage",
    "typecheck:src": "tsc --noEmit",
    "typecheck:scripts": "tsc -p scripts --noEmit",
    "typecheck:e2e": "tsc -p e2e --noEmit",
    "typecheck:coverage": "bun run scripts/typecheck-coverage.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sdk:link": "bun run scripts/sdk-dev.ts link",
    "sdk:status": "bun run scripts/sdk-dev.ts status",
    "sdk:restore": "bun run scripts/sdk-dev.ts restore",
    "pack:bundle": "bun run scripts/pack-bundle.ts",
    "release:gate": "bun run scripts/release-gate.ts",
    "gate": "bun run test && bun run typecheck && bun run build && bun run release:gate",
    "prepublishOnly": "bun run release:gate"
  },
  "dependencies": {
    "@pellux/goodvibes-sdk": "2.0.8",
    "@tanstack/react-query": "^5.100.11",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.16.0",
    "onnxruntime-web": "1.27.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@happy-dom/global-registrator": "20.10.6",
    "@playwright/test": "^1.61.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "10.5.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "happy-dom": "^20.10.6",
    "prettier": "3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.61.1",
    "vite": "^8.0.13"
  }
}
